# Copy to .dev.vars for local secrets. Never commit .dev.vars.
# Leave keys blank to run the scripted receptionist with no external model.

PUBLIC_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=
RESEND_FROM=
TEST_TOKEN=
SESSION_SECRET=
# Optional Twilio ConversationRelay voice override (female).
# Amazon default is Joanna-Generative. ElevenLabs uses a voice id configured in Twilio.
# ELEVENLABS_VOICE_ID=
