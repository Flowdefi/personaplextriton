# Copy to .env for local secrets. Never commit .env.

LEAD_EMAIL_TO=portfolios@debtmarket.net
BUSINESS_PHONE=561-254-6608
LEADS_DIR=leads

# Open-source speech understanding. Install Ollama and pull the model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=Qwen3.8-27B-Uncensored
# OLLAMA_DISABLED=1

# Female voice. espeak-ng is the default. Piper is used when both are set.
ESPEAK_BIN=espeak-ng
ESPEAK_VOICE=en-us+f3
# PIPER_BIN=piper
# PIPER_MODEL=/path/en_US-lessac-medium.onnx

# Vosk transcription. Download the small English model and point VOSK_MODEL at the folder.
STT_COMMAND=python3 bin/transcribe.py
# VOSK_MODEL=/path/vosk-model-small-en-us-0.15

# Mail through any SMTP server you control. Leave blank to store the lead file only.
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_MODE=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Triton Desk <desk@debtmarket.net>
# TEST_TOKEN=
