{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "triton-voice-receptionist",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_SESSION",
        "class_name": "CallSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CallSession"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LEADS",
      "id": "00000000000000000000000000000000"
    }
  ],
  "vars": {
    "LEAD_EMAIL_TO": "portfolios@debtmarket.net",
    "BUSINESS_PHONE": "561-254-6608",
    "BUSINESS_NAME": "Triton Financial Solutions, LLC",
    "BUSINESS_SITE": "https://www.debtmarket.net",
    "FEMALE_VOICE": "Joanna-Generative",
    "TTS_PROVIDER": "Amazon",
    "SAY_VOICE": "Polly.Joanna-Generative",
    "OPENAI_REALTIME_MODEL": "gpt-realtime-2.1",
    "OPENAI_TEXT_MODEL": "gpt-6-astra",
    "ANTHROPIC_MODEL": "claude-opus-5",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "VOICE_TRANSPORT": "relay"
  }
}
